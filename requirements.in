# Core: everything the Phase 0 eval harness and leakage test need, and nothing
# more. Kept tiny on purpose so CI installs in seconds and `make leakage` is
# cheap enough to run after every data change, as CLAUDE.md requires.
#
# NO model libraries here. torch/transformers/faiss live in requirements-ml.in.

pyyaml>=6.0        # eval config files
jsonschema>=4.21   # validate every config before a single metric is computed
numpy>=1.26        # metric arithmetic
pydantic>=2.7      # src/pipeline/contracts.py. In the CORE lock on purpose:
                   # CI runs without torch, and the contract tests must still
                   # run there -- they are what keeps the pipeline's label
                   # strings in step with src/data/labels.py.
