# Phase 1+ model stack. Locked now so the versions are decided while nothing
# depends on them, installed later with `make setup-ml`.
#
# torch is deliberately NOT in this lock. Install it from the PyTorch index so
# the CPU and CUDA builds stay explicit and are never confused for one another.
# This machine has an RTX 4050, so it takes the CUDA build:
#   uv pip install torch==2.9.1 --index-url https://download.pytorch.org/whl/cu128
# The resolved build string is recorded in docs/environment.md and stamped into
# every results JSON by src/common/provenance.py.

-c requirements.txt

transformers>=4.44
sentence-transformers>=3.0   # BGE-M3, LaBSE, MuRIL
datasets>=2.20
accelerate>=0.33
peft>=0.12                   # LoRA - required to fit training into 6 GB VRAM
faiss-cpu>=1.8
rank-bm25>=0.2.2
fasttext-wheel>=0.9.2        # language ID

# Transliteration (FR-5, Phase 2). This is the rule-based fallback that
# SYSTEM_DESIGN.md §10 names, pinned deliberately as the BASELINE rather than
# as a contingency: IndicXlit (`ai4bharat-transliteration`) depends on fairseq,
# which does not install cleanly on Windows + Python 3.11 -- confirmed from its
# PyPI metadata, not assumed. The Day-2 spike tries IndicXlit as an UPGRADE; if
# it lands, its accuracy is compared against this on Dakshina and the better one
# wins. Either way Phase 2 is never blocked on a package that may not install.
indic-transliteration>=2.3    # rule-based Roman <-> Deva/Guru
indic-nlp-library>=0.92       # Indic normalisation, script utilities
# Word2Vec for the Phase 2 embedding ladder. Trained IN-DOMAIN on the MultiClaim
# corpus rather than loaded pretrained: no credible pretrained Punjabi Word2Vec
# exists, the fastText vector files are ~7 GB per language, and a model trained
# on this data handles romanized text natively because it was trained on it.
gensim>=4.3

pandas>=2.2
